{
  "version": 2,
  "builds": [
    {
      "src": "api/index.mjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "artifacts/api-server/dist/**",
          "artifacts/comuni-app/dist/public/**"
        ]
      }
    },
    {
      "src": "api/[...path].mjs",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30,
        "includeFiles": [
          "artifacts/api-server/dist/**",
          "artifacts/comuni-app/dist/public/**"
        ]
      }
    },
    {
      "src": "artifacts/comuni-app/package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "pnpm --filter @workspace/comuni-app run build && pnpm --filter @workspace/api-server run build",
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/[...path].mjs"
    }
  ]
}