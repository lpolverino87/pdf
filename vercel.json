{
  "version": 2,
  "functions": {
    "api/index.mjs": {
      "maxDuration": 30,
      "includeFiles": ["artifacts/api-server/dist/**"]
    },
    "api/[...path].mjs": {
      "maxDuration": 30,
      "includeFiles": ["artifacts/api-server/dist/**"]
    }
  },
  "builds": [
    {
      "src": "api/index.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "api/[...path].mjs",
      "use": "@vercel/node"
    },
    {
      "src": "artifacts/comuni-app/package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "pnpm --filter @workspace/comuni-app run build && pnpm --filter @workspace/api-server run build",
        "distDir": "dist/public"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/[...path].mjs"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}